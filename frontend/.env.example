# MindFlow Frontend Environment Variables

# API Configuration
# Public URL - Used by browser (client-side) requests
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api/v1

# Internal URL - Used by server-side requests within Docker network
# This should point to the API gateway service name when running in Docker
# In development without Docker, this can be omitted (falls back to NEXT_PUBLIC_API_BASE_URL)
# API_BASE_URL_INTERNAL=http://api-gateway:3001/api/v1

# App URL
NEXT_PUBLIC_APP_URL=http://localhost:3002

# Feature Flags
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# Third-party Services (if needed)
NEXT_PUBLIC_SENTRY_DSN=

# Multi-tenant Configuration
NEXT_PUBLIC_DEFAULT_TENANT=mindflow
