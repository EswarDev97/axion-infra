{
  "$schema": "https://claude.ai/schemas/lsp.json",
  "description": "Language Server Protocol configuration for AICodePath",
  "servers": {
    "typescript": {
      "command": "typescript-language-server",
      "args": ["--stdio"],
      "extensionToLanguage": {
        ".ts": "typescript",
        ".tsx": "typescript",
        ".js": "javascript",
        ".jsx": "javascript",
        ".mjs": "javascript",
        ".cjs": "javascript"
      },
      "initializationOptions": {
        "preferences": {
          "importModuleSpecifierPreference": "relative",
          "includeInlayParameterNameHints": "all",
          "includeInlayFunctionParameterTypeHints": true,
          "includeInlayVariableTypeHints": true
        }
      },
      "enabled": true,
      "required": false,
      "installCommand": "npm install -g typescript-language-server typescript"
    },
    "python": {
      "command": "pyright-langserver",
      "args": ["--stdio"],
      "extensionToLanguage": {
        ".py": "python",
        ".pyi": "python"
      },
      "initializationOptions": {
        "python": {
          "analysis": {
            "typeCheckingMode": "basic",
            "diagnosticMode": "workspace",
            "autoSearchPaths": true,
            "useLibraryCodeForTypes": true
          }
        }
      },
      "enabled": true,
      "required": false,
      "installCommand": "pip install pyright"
    },
    "rust": {
      "command": "rust-analyzer",
      "args": [],
      "extensionToLanguage": {
        ".rs": "rust"
      },
      "initializationOptions": {
        "cargo": {
          "loadOutDirsFromCheck": true,
          "allFeatures": true
        },
        "procMacro": {
          "enable": true
        },
        "checkOnSave": {
          "command": "clippy"
        }
      },
      "enabled": true,
      "required": false,
      "installCommand": "rustup component add rust-analyzer"
    },
    "go": {
      "command": "gopls",
      "args": ["serve"],
      "extensionToLanguage": {
        ".go": "go"
      },
      "initializationOptions": {
        "analyses": {
          "unusedparams": true,
          "shadow": true
        },
        "staticcheck": true,
        "gofumpt": true
      },
      "enabled": true,
      "required": false,
      "installCommand": "go install golang.org/x/tools/gopls@latest"
    },
    "json": {
      "command": "vscode-json-languageserver",
      "args": ["--stdio"],
      "extensionToLanguage": {
        ".json": "json",
        ".jsonc": "jsonc"
      },
      "initializationOptions": {
        "provideFormatter": true
      },
      "enabled": true,
      "required": false,
      "installCommand": "npm install -g vscode-langservers-extracted"
    },
    "yaml": {
      "command": "yaml-language-server",
      "args": ["--stdio"],
      "extensionToLanguage": {
        ".yaml": "yaml",
        ".yml": "yaml"
      },
      "initializationOptions": {
        "yaml": {
          "schemas": {
            "https://json.schemastore.org/github-workflow.json": ".github/workflows/*.{yml,yaml}",
            "https://json.schemastore.org/package.json": "package.json"
          },
          "format": {
            "enable": true
          },
          "validate": true
        }
      },
      "enabled": true,
      "required": false,
      "installCommand": "npm install -g yaml-language-server"
    },
    "docker": {
      "command": "docker-langserver",
      "args": ["--stdio"],
      "extensionToLanguage": {
        "Dockerfile": "dockerfile",
        ".dockerfile": "dockerfile"
      },
      "initializationOptions": {},
      "enabled": false,
      "required": false,
      "installCommand": "npm install -g dockerfile-language-server-nodejs"
    }
  },
  "features": {
    "diagnostics": {
      "enabled": true,
      "onSave": true,
      "onChange": true,
      "debounceMs": 500
    },
    "hover": {
      "enabled": true
    },
    "completion": {
      "enabled": true
    },
    "definition": {
      "enabled": true
    },
    "references": {
      "enabled": true
    },
    "formatting": {
      "enabled": true,
      "onSave": false
    }
  },
  "hooks": {
    "preValidation": {
      "enabled": true,
      "description": "Run LSP diagnostics before hook validation"
    },
    "postEdit": {
      "enabled": true,
      "description": "Get LSP diagnostics after file edits"
    }
  },
  "notes": {
    "installation": "Language servers must be installed separately. Use installCommand for each server.",
    "performance": "LSP adds ~50-100ms latency. Disable specific servers if not needed.",
    "optional": "All language servers are optional. Plugin works without them.",
    "integration": "LSP diagnostics are available to hooks via getLSPDiagnostics()"
  }
}
