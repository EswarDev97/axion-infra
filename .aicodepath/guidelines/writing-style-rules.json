{
  "$schema": "AICodePath Writing Style Guidelines",
  "version": "1.0.0",
  "description": "Rules for clear, concise technical writing avoiding AI-generated patterns",
  "categories": {
    "ai_anti_patterns": {
      "description": "Patterns commonly generated by AI that should be avoided in technical writing",
      "critical": true,
      "rules": [
        {
          "id": "no-puffery-words",
          "description": "Avoid inflated, vague words that add no meaning",
          "pattern": "\\b(pivotal|crucial|groundbreaking|game-changing|revolutionary|cutting-edge|state-of-the-art|best-in-class|world-class|next-generation|innovative|synergy|leverage|empower|robust|seamless|holistic|scalable|paradigm|ecosystem)\\b",
          "severity": "warning",
          "priority": "MEDIUM",
          "languages": [
            "*"
          ],
          "message": "Avoid puffery words that add no concrete meaning. Be specific about what something actually does.",
          "examples": {
            "bad": "This groundbreaking solution leverages cutting-edge technology",
            "good": "This solution uses vector search for semantic matching"
          }
        },
        {
          "id": "no-delve-explore",
          "description": "Avoid overused AI transition words",
          "pattern": "\\b(delve|delving|delved|dive deep|diving deep|explore|exploring|unpack|unpacking|dissect|dissecting|embark|embarking)\\b",
          "severity": "info",
          "priority": "LOW",
          "languages": [
            "*"
          ],
          "message": "Avoid overused AI transition phrases. Use simpler alternatives like 'examine', 'analyze', or 'discuss'."
        },
        {
          "id": "no-realm-landscape",
          "description": "Avoid vague domain metaphors",
          "pattern": "\\b(realm|landscape|arena|sphere|domain of|world of|space of|universe of|tapestry|fabric of)\\b",
          "severity": "info",
          "priority": "LOW",
          "languages": [
            "*"
          ],
          "message": "Avoid vague metaphors. Name the specific area or concept directly."
        },
        {
          "id": "no-ensure-comprehensive",
          "description": "Avoid hollow assurance words",
          "pattern": "\\b(ensure|ensures|ensuring|comprehensive|comprehensively|meticulous|meticulously|thorough|thoroughly|rigorous|rigorously)\\s+(that|the|a|an|all|every|each)",
          "severity": "info",
          "priority": "LOW",
          "languages": [
            "*"
          ],
          "message": "These words often promise without delivering. Show HOW something is achieved instead."
        },
        {
          "id": "no-firstly-moreover",
          "description": "Avoid formal connector overuse",
          "pattern": "\\b(firstly|secondly|thirdly|furthermore|moreover|additionally|consequently|subsequently|henceforth|thereafter|whereby|wherein|herein)\\b",
          "severity": "info",
          "priority": "LOW",
          "languages": [
            "*"
          ],
          "message": "Prefer simpler connectors: 'first', 'second', 'also', 'so', 'then', or restructure sentences."
        },
        {
          "id": "no-it-is-important",
          "description": "Avoid vague importance claims",
          "pattern": "(it is|it's|this is)\\s+(important|crucial|critical|essential|vital|imperative|paramount)\\s+(to|that)",
          "severity": "warning",
          "priority": "MEDIUM",
          "languages": [
            "*"
          ],
          "message": "Instead of claiming importance, directly state what to do. 'It is important to validate input' → 'Validate input'."
        },
        {
          "id": "no-in-order-to",
          "description": "Avoid verbose phrases",
          "pattern": "\\b(in order to|for the purpose of|with the aim of|with a view to|so as to|in an effort to)\\b",
          "severity": "info",
          "priority": "LOW",
          "languages": [
            "*"
          ],
          "message": "Use 'to' instead of 'in order to'. Be direct."
        },
        {
          "id": "no-basically-essentially",
          "description": "Avoid filler words that weaken statements",
          "pattern": "\\b(basically|essentially|fundamentally|literally|actually|really|very|quite|rather|somewhat|fairly|pretty much)\\b",
          "severity": "info",
          "priority": "LOW",
          "languages": [
            "*"
          ],
          "message": "These words usually add nothing. Remove them and the sentence becomes stronger."
        },
        {
          "id": "no-as-such-thus",
          "description": "Avoid stilted academic connectors",
          "pattern": "\\b(as such|thus|hence|therefore|accordingly|as a result|in conclusion|to summarize|in summary|all in all)\\b",
          "severity": "info",
          "priority": "LOW",
          "languages": [
            "*"
          ],
          "message": "Prefer natural connectors or restructure. Often these can be removed entirely."
        },
        {
          "id": "no-utilize-leverage",
          "description": "Avoid unnecessarily complex verbs in documentation",
          "pattern": "\\b(utilize|utilizes|utilizing|utilization|leverage|leverages|leveraging|facilitate|facilitates|facilitating)\\b",
          "severity": "info",
          "priority": "LOW",
          "languages": [
            "*"
          ],
          "file_patterns": ["**/*.md", "**/*.txt", "**/*.mdx"],
          "message": "Use simple verbs: 'utilize' → 'use', 'leverage' → 'use', 'facilitate' → 'help/enable'."
        }
      ]
    },
    "clarity": {
      "description": "Rules for clear, direct communication",
      "rules": [
        {
          "id": "prefer-active-voice",
          "description": "Prefer active voice over passive voice",
          "pattern": "(is|are|was|were|be|been|being)\\s+(\\w+ed|\\w+en)\\s+(by|when|if|after|before)",
          "severity": "info",
          "priority": "LOW",
          "languages": [
            "*"
          ],
          "message": "Passive voice detected. Consider active voice: 'The file was created by the user' → 'The user created the file'."
        },
        {
          "id": "avoid-double-negatives",
          "description": "Avoid double negatives which confuse meaning",
          "pattern": "\\b(not|don't|doesn't|won't|can't|shouldn't|wouldn't)\\s+\\w*\\s*\\b(not|no|un\\w+|in\\w+|dis\\w+|non\\w+)\\b",
          "file_patterns": [
            "**/*.md",
            "**/*.txt",
            "!**/__tests__/**",
            "!**/test/**",
            "!**/tests/**"
          ],
          "severity": "warning",
          "priority": "MEDIUM",
          "languages": [
            "*"
          ],
          "message": "Double negative detected. Use positive phrasing: 'not uncommon' → 'common'."
        },
        {
          "id": "avoid-noun-strings",
          "description": "Avoid long noun strings",
          "pattern": "\\b([A-Z][a-z]+\\s){4,}[A-Z][a-z]+\\b",
          "severity": "info",
          "priority": "LOW",
          "languages": [
            "*"
          ],
          "message": "Long noun strings (4+ nouns) are hard to parse. Add prepositions or restructure."
        },
        {
          "id": "be-specific",
          "description": "Avoid vague quantifiers",
          "pattern": "\\b(several|many|some|few|various|numerous|a lot of|a number of|a variety of)\\s+(\\w+s)\\b",
          "severity": "info",
          "priority": "LOW",
          "languages": [
            "*"
          ],
          "message": "Vague quantifiers reduce precision. Use specific numbers when possible."
        }
      ]
    },
    "technical_writing": {
      "description": "Standards for technical documentation and code comments",
      "rules": [
        {
          "id": "comment-why-not-what",
          "description": "Comments should explain why, not what",
          "pattern": "//\\s*(increment|add|set|get|return|call|create|update|delete|remove|check|validate)\\s",
          "severity": "info",
          "priority": "MEDIUM",
          "languages": [
            "javascript",
            "typescript",
            "java",
            "csharp",
            "go"
          ],
          "message": "This comment describes what the code does (obvious from code). Explain WHY instead."
        },
        {
          "id": "no-obvious-comments",
          "description": "Avoid comments that state the obvious",
          "pattern": "//\\s*(this|the)\\s+(function|method|class|variable|constant|loop|if statement)",
          "severity": "info",
          "priority": "LOW",
          "languages": [
            "javascript",
            "typescript",
            "java",
            "csharp"
          ],
          "message": "Comment states the obvious. Remove or explain the reasoning instead."
        },
        {
          "id": "jsdoc-description-first",
          "description": "JSDoc should start with a concise description",
          "pattern": "/\\*\\*\\s*\\n\\s*\\*\\s*@",
          "severity": "warning",
          "priority": "MEDIUM",
          "languages": [
            "javascript",
            "typescript"
          ],
          "message": "JSDoc should start with a description before @param tags."
        },
        {
          "id": "readme-no-fluff",
          "description": "README should have actionable content",
          "pattern": "This (project|repository|package|module) (is|provides|offers)",
          "severity": "info",
          "priority": "LOW",
          "file_patterns": [
            "README*",
            "readme*"
          ],
          "message": "Start README with what the reader can DO, not what the project IS."
        },
        {
          "id": "avoid-weasel-words",
          "description": "Avoid weasel words in documentation",
          "pattern": "\\b(may|might|could|possibly|potentially|generally|usually|often|sometimes|typically|normally)\\s+(be|cause|result|lead)",
          "severity": "info",
          "priority": "LOW",
          "languages": [
            "*"
          ],
          "message": "Weasel words reduce confidence. State facts clearly or specify conditions."
        }
      ]
    }
  },
  "replacement_suggestions": {
    "description": "Suggested replacements for common problematic phrases",
    "phrases": {
      "in order to": "to",
      "at this point in time": "now",
      "due to the fact that": "because",
      "in the event that": "if",
      "for the purpose of": "to, for",
      "in the near future": "soon",
      "in close proximity to": "near",
      "a large number of": "many",
      "in spite of the fact that": "although",
      "with regard to": "about",
      "utilize": "use",
      "leverage": "use",
      "facilitate": "help, enable",
      "implement": "add, build, create",
      "functionality": "feature, capability",
      "methodology": "method, approach",
      "prior to": "before",
      "subsequent to": "after",
      "in conjunction with": "with",
      "at the present time": "now",
      "make a decision": "decide",
      "give consideration to": "consider",
      "is able to": "can",
      "has the ability to": "can",
      "in the majority of cases": "usually",
      "it is necessary that": "must",
      "has the capability": "can"
    }
  }
}
