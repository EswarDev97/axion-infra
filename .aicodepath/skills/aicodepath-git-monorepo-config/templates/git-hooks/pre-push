#!/bin/bash
# Pre-push hook for environment safety
# Auto-generated by git-monorepo-config skill

BRANCH=$(git rev-parse --abbrev-ref HEAD)
REMOTE=$2

echo "Pre-push check for branch: $BRANCH"

# Check if pushing to production branch
if [[ "$BRANCH" == "main" ]] || [[ "$BRANCH" == "master" ]]; then
    echo ""
    echo "WARNING: PRODUCTION BRANCH!"
    echo "======================================="
    echo "You are about to push to the production branch."
    echo "This will trigger a production deployment."
    echo "======================================="
    echo ""
    read -p "Type 'production' to confirm: " confirmation

    if [[ "$confirmation" != "production" ]]; then
        echo "Push cancelled"
        exit 1
    fi

    echo "Production push confirmed"
fi

# Check if pushing to staging
if [[ "$BRANCH" == "staging" ]]; then
    echo "Pushing to STAGING environment"
    read -p "Continue? (yes/no): " confirmation

    if [[ "$confirmation" != "yes" ]]; then
        echo "Push cancelled"
        exit 1
    fi
fi

echo "Pre-push checks passed"
exit 0
