#!/bin/bash
# Pre-commit hook for code quality
# Auto-generated by git-monorepo-config skill

echo "Running pre-commit checks..."

ISSUES=0

# Check for debug statements
if git diff --cached --name-only | xargs grep -n "console\.log\|debugger\|pdb\.set_trace" 2>/dev/null; then
    echo "Warning: Debug statements found"
    echo "Consider removing before committing"
    read -p "Proceed anyway? (yes/no): " proceed
    if [[ "$proceed" != "yes" ]]; then
        exit 1
    fi
fi

# Check for large files (>10MB)
for file in $(git diff --cached --name-only); do
    if [ -f "$file" ]; then
        size=$(wc -c < "$file")
        if [ "$size" -gt 10485760 ]; then
            echo "Error: File $file is larger than 10MB"
            echo "Large files should not be committed to Git"
            ISSUES=$((ISSUES + 1))
        fi
    fi
done

# Check for sensitive information patterns
if git diff --cached | grep -iE "(password|secret|api[_-]?key|private[_-]?key|token)\s*[:=]" 2>/dev/null; then
    echo "Warning: Possible sensitive information detected"
    echo "Patterns like 'password', 'secret', 'api_key' found"
    read -p "Are you sure these are not secrets? (yes/no): " confirm
    if [[ "$confirm" != "yes" ]]; then
        exit 1
    fi
fi

if [ "$ISSUES" -gt 0 ]; then
    echo "Pre-commit checks failed with $ISSUES issues"
    exit 1
fi

echo "Pre-commit checks passed"
exit 0
