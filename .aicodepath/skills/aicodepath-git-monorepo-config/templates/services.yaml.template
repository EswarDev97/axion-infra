# Service manifest for monorepo
# Auto-generated by git-monorepo-config skill
# Last updated: {{TIMESTAMP}}

version: "1.0"

# Repository information
repository:
  platform: {{PLATFORM}}  # github, gitlab, or bitbucket
  branches:
    development: dev
    staging: staging
    production: main

# Detected services
services:
  # Each service entry:
  # - name: service-name
  #   path: services/service-name
  #   type: node|python|go|java-maven|java-gradle
  #   has_dockerfile: true|false
  #   dependencies: []
{{SERVICES}}

# Git workflow configuration
workflow:
  branch_protection:
    enabled: true
    dev:
      required_reviewers: 1
      enforce_admins: false
    staging:
      required_reviewers: 2
      enforce_admins: true
    main:
      required_reviewers: 3
      enforce_admins: true
      require_signed_commits: true

  hooks:
    pre_commit: true
    pre_push: true
    commit_msg: true

# Status tracking (for integration with gcp-monorepo-deploy)
setup_status:
  git_configured: true
  branches_created: true
  protection_rules_configured: false
  hooks_installed: true
  services_detected: true
  ready_for_deployment: true
  last_updated: {{TIMESTAMP}}
