# Per-service Cloud Build configuration
# Auto-generated by gcp-monorepo-deploy skill
#
# Template for individual service build/push/deploy pipeline.
# Copy to services/<service-name>/cloudbuild.yaml and customize substitutions.

steps:
  - name: 'gcr.io/cloud-builders/docker'
    id: 'build'
    args:
      - 'build'
      - '-t'
      - '${_REGION}-docker.pkg.dev/${PROJECT_ID}/${_ARTIFACT_REPO}/${_SERVICE_NAME}:${SHORT_SHA}'
      - '-t'
      - '${_REGION}-docker.pkg.dev/${PROJECT_ID}/${_ARTIFACT_REPO}/${_SERVICE_NAME}:latest'
      - '.'

  - name: 'gcr.io/cloud-builders/docker'
    id: 'push'
    args:
      - 'push'
      - '--all-tags'
      - '${_REGION}-docker.pkg.dev/${PROJECT_ID}/${_ARTIFACT_REPO}/${_SERVICE_NAME}'

  - name: 'gcr.io/google.com/cloudsdktool/cloud-sdk'
    id: 'deploy'
    entrypoint: 'gcloud'
    args:
      - 'run'
      - 'deploy'
      - '${_SERVICE_NAME}-${_ENV}'
      - '--image=${_REGION}-docker.pkg.dev/${PROJECT_ID}/${_ARTIFACT_REPO}/${_SERVICE_NAME}:${SHORT_SHA}'
      - '--platform=managed'
      - '--region=${_REGION}'
      - '--project=${_TARGET_PROJECT}'
      - '--quiet'

substitutions:
  _SERVICE_NAME: '{{SERVICE_NAME}}'
  _ENV: dev
  _TARGET_PROJECT: '{{PROJECT_ID}}'
  _REGION: '{{REGION}}'
  _ARTIFACT_REPO: docker-repo

timeout: '1200s'
