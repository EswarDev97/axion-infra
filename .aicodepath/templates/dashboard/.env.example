# AICodePath Dashboard Environment Variables

# =============================================================================
# Development Mode
# =============================================================================
# When set to 'true', AICodePath will skip strict plugin/MCP checks
# Useful for development or when working offline
# Default: auto-detected (enabled if project path contains 'aicodepath-tool')
AICODEPATH_DEV_MODE=

# =============================================================================
# GICL (Git-Integrated Context Learning)
# =============================================================================
# Disable GICL to opt-out of automatic context preservation in git workflow
# Default: false (GICL enabled by default)
# AICODEPATH_GICL_DISABLED=true

# =============================================================================
# Database Configuration
# =============================================================================
# Optional: Database path override
# AICODEPATH_DB_PATH=/custom/path/to/aicodepath.db

# =============================================================================
# Logging & Debugging
# =============================================================================
# Optional: Enable debug logging
# DEBUG=true

# =============================================================================
# API Configuration
# =============================================================================
# API server port (must match vite.config.ts proxy target)
# Dashboard runs on 3899, API runs on 3888
PORT=3888
API_PORT=3888

# =============================================================================
# Anthropic AI API
# =============================================================================
# Anthropic AI API (required for AI Assistant features)
# Get your API key from: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: Custom model selection
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
