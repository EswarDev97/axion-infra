# AICodePath Environment Configuration
# This file is located at: .aicodepath/.env.aicodepath
# All variables here are optional - AICodePath works with sensible defaults

# ==========================================
# Core AICodePath Settings
# ==========================================

# Node environment (development or production)
# Use 'production' for target projects, 'development' only for AICodePath framework development
NODE_ENV=production

# Development mode (allows missing plugins, more verbose logging)
# Set to 'true' only during AICodePath development/debugging
# For target projects, keep as 'false' (default)
AICODEPATH_DEV_MODE=false

# Maximum number of agents to run concurrently during CONSTRUCTION phase
# Default: 3 (increase for powerful machines, decrease for resource constraints)
AICODEPATH_MAX_CONCURRENCY=3

# Disable Git-Integrated Context Learning (GICL)
# Default: false (GICL is enabled by default)
# AICODEPATH_GICL_DISABLED=false

# Enable experimental agent teams feature (requires Claude Code Agent Teams)
# Auto-managed: AICodePath sets this in .claude/settings.json env block (per-project) when swarm is enabled.
# Override here only if you need to disable it for this project specifically.
CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS=1

# ==========================================
# Database & Storage
# ==========================================

# Path to AICodePath knowledge base (SQLite database)
# Default: aicodepath-docs/aicodepath.db (relative to project root)
# Example: AICODEPATH_DB_PATH=/custom/path/aicodepath.db
# Leave blank to use default location

# ==========================================
# Logging & Debugging
# ==========================================

# Log level (debug, info, warn, error)
# Default: info
LOG_LEVEL=info

# Enable hook development mode (more verbose hook output)
# Set to 'true' for debugging hook issues
AICODEPATH_HOOK_DEV=false

# ==========================================
# Web Dashboard
# ==========================================

# Port for AICodePath web dashboard
# Default: 8080
DASHBOARD_PORT=3899

# ==========================================
# Optional: Claude API (usually handled by Claude Code settings)
# ==========================================

# Anthropic API key (optional - Claude Code usually manages this)
# Only needed if running AICodePath CLI tools directly
# ANTHROPIC_API_KEY=sk-ant-...

# ==========================================
# Advanced: Hook Testing
# ==========================================

# Tool name for testing hooks (internal use)
# HOOK_TOOL_NAME=Write

# Tool input for testing hooks (internal use)
# HOOK_TOOL_INPUT={}

# ==========================================
# Advanced: Session Management
# ==========================================

# Session ID (auto-generated, usually not set manually)
# AICODEPATH_SESSION_ID=...

# Current workflow phase (auto-managed)
# Values: PRE-FLIGHT, INCEPTION, CONSTRUCTION, OPERATIONS, COMPLETED
# AICODEPATH_PHASE=PRE-FLIGHT

# ==========================================
# Notes for Developers
# ==========================================
#
# 1. This file should NOT be committed to version control
#    - Add .env.aicodepath to your .gitignore
#
# 2. Most settings have intelligent defaults
#    - Delete unnecessary variables to keep the file clean
#
# 3. For development, AICODEPATH_DEV_MODE=true is recommended
#    - Allows workflow to continue without all plugins
#    - Provides more verbose error messages
#
# 4. To reset to defaults, delete this file entirely
#    - AICodePath will recreate with defaults on next session start
#
# 5. Multi-agent settings:
#    - AICODEPATH_MAX_CONCURRENCY: Increase for parallel execution
#    - CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS: Enable agent teams feature
#
# For more information, see:
# - .aicodepath/DEVELOPER-GUIDE.md (development rules)
# - QUICKSTART.md (setup guide)
# - USER_GUIDE.md (comprehensive reference)
