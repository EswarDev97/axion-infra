    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf /*)",
      "Bash(curl*|sh)",
      "Bash(wget*|sh)",
      "Bash(eval*)",
      "Write(.env)",
