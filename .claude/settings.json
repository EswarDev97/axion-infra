      "Write(*)",
      "Edit(*)",
      "Bash(git commit*)",
      "Bash(git push*)",
      "Bash(git checkout*)",
      "Bash(git merge*)",
      "Bash(git rebase*)",
      "Bash(npm publish*)",
      "Bash(npm install*)",
      "Bash(rm *)",
      "Bash(mv *)",
      "Bash(cp *)"
