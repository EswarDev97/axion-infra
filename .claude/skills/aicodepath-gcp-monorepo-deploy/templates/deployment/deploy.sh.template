#!/bin/bash
# Deployment helper script
# Auto-generated by gcp-monorepo-deploy skill
#
# Usage: ./scripts/deploy.sh <environment> [services...]
# Environments: dev, staging, prod
# Services: (optional) space-separated service names

set -e

GREEN='\033[0;32m'
YELLOW='\033[1;33m'
RED='\033[0;31m'
NC='\033[0m'

if [ $# -lt 1 ]; then
    echo "Usage: ./scripts/deploy.sh <environment> [services...]"
    echo ""
    echo "Environments: dev, staging, prod"
    echo "Services: (optional) space-separated service names"
    echo ""
    echo "Examples:"
    echo "  ./scripts/deploy.sh dev"
    echo "  ./scripts/deploy.sh staging api-gateway auth-service"
    echo ""
    exit 1
fi

ENV=$1
shift
SERVICES=("$@")

# Load configuration
if [ ! -f ".gcp-projects" ]; then
    echo -e "${RED}Error: .gcp-projects not found${NC}"
    echo "Run GCP setup first"
    exit 1
fi

source .gcp-projects

# Determine project
case "$ENV" in
    dev|development)
        PROJECT=$DEV_PROJECT
        ENV="dev"
        ;;
    staging|stg)
        PROJECT=$STG_PROJECT
        ENV="staging"
        ;;
    prod|production)
        PROJECT=$PROD_PROJECT
        ENV="prod"
        ;;
    *)
        echo -e "${RED}Invalid environment: $ENV${NC}"
        echo "Valid: dev, staging, prod"
        exit 1
        ;;
esac

echo -e "${GREEN}Deploying to $ENV${NC}"
echo "Project: $PROJECT"
echo "Region: $REGION"

# If no services specified, deploy all
if [ ${#SERVICES[@]} -eq 0 ]; then
    echo "Deploying all services"
    mapfile -t SERVICES < <(yq eval '.services[].name' services.yaml)
else
    echo "Deploying specific services: ${SERVICES[*]}"
fi

# Confirm for production
if [ "$ENV" = "prod" ]; then
    echo ""
    echo -e "${YELLOW}WARNING: Deploying to PRODUCTION${NC}"
    read -p "Type 'production' to confirm: " confirmation
    if [ "$confirmation" != "production" ]; then
        echo "Deployment cancelled"
        exit 1
    fi
fi

# Deploy each service
DEPLOYED=0
FAILED=0

for service in "${SERVICES[@]}"; do
    echo ""
    echo -e "${GREEN}Deploying $service...${NC}"

    SERVICE_PATH=$(yq eval ".services[] | select(.name == \"$service\") | .path" services.yaml)

    if [ "$SERVICE_PATH" = "null" ] || [ -z "$SERVICE_PATH" ]; then
        echo -e "${RED}Service not found in services.yaml: $service${NC}"
        FAILED=$((FAILED + 1))
        continue
    fi

    if [ -f "$SERVICE_PATH/cloudbuild.yaml" ]; then
        gcloud builds submit \
            --project="$PROJECT" \
            --config="$SERVICE_PATH/cloudbuild.yaml" \
            --substitutions="_ENV=$ENV,_SERVICE_NAME=$service,_TARGET_PROJECT=$PROJECT,_REGION=$REGION" \
            "$SERVICE_PATH"
    else
        echo -e "${YELLOW}No cloudbuild.yaml found for $service, using root config${NC}"
        gcloud builds submit \
            --project="$PROJECT" \
            --config="cloudbuild.yaml" \
            --substitutions="_ENV=$ENV,_DEPLOY_ALL=false" \
            .
    fi

    echo -e "${GREEN}$service deployed${NC}"
    DEPLOYED=$((DEPLOYED + 1))
done

echo ""
if [ "$FAILED" -gt 0 ]; then
    echo -e "${YELLOW}Deployment complete: $DEPLOYED succeeded, $FAILED failed${NC}"
    exit 1
else
    echo -e "${GREEN}Deployment complete: $DEPLOYED services deployed${NC}"
fi
