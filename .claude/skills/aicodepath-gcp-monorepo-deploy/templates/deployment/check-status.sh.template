#!/bin/bash
# Status check script
# Auto-generated by gcp-monorepo-deploy skill
#
# Usage: ./scripts/check-status.sh <environment>
# Checks health of all services in the specified environment.

GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m'

ENV=$1

if [ -z "$ENV" ]; then
    echo "Usage: ./scripts/check-status.sh <environment>"
    echo "Environments: dev, staging, prod"
    exit 1
fi

if [ ! -f ".gcp-projects" ]; then
    echo -e "${RED}Error: .gcp-projects not found${NC}"
    exit 1
fi

source .gcp-projects

case "$ENV" in
    dev) PROJECT=$DEV_PROJECT ;;
    staging) PROJECT=$STG_PROJECT ;;
    prod) PROJECT=$PROD_PROJECT ;;
    *)
        echo -e "${RED}Invalid environment: $ENV${NC}"
        exit 1
        ;;
esac

echo "Checking status in $ENV environment (project: $PROJECT)"
echo ""

# Get all services
mapfile -t SERVICES < <(yq eval '.services[].name' services.yaml)

HEALTHY=0
UNHEALTHY=0
NOT_DEPLOYED=0

for service in "${SERVICES[@]}"; do
    SERVICE_NAME="$service-$ENV"

    printf "  %-30s " "$service"

    # Check if service exists
    if ! gcloud run services describe "$SERVICE_NAME" \
        --project="$PROJECT" \
        --region="$REGION" &> /dev/null; then
        echo -e "${YELLOW}NOT DEPLOYED${NC}"
        NOT_DEPLOYED=$((NOT_DEPLOYED + 1))
        continue
    fi

    # Get service URL
    SERVICE_URL=$(gcloud run services describe "$SERVICE_NAME" \
        --project="$PROJECT" \
        --region="$REGION" \
        --format='value(status.url)')

    # Health check
    HTTP_CODE=$(curl -s -o /dev/null -w "%{http_code}" --max-time 10 "$SERVICE_URL/health" 2>/dev/null || echo "000")

    if [ "$HTTP_CODE" = "200" ]; then
        echo -e "${GREEN}HEALTHY${NC}  $SERVICE_URL"
        HEALTHY=$((HEALTHY + 1))
    else
        echo -e "${RED}UNHEALTHY${NC}  (HTTP $HTTP_CODE)"
        UNHEALTHY=$((UNHEALTHY + 1))
    fi
done

echo ""
echo "================================"
echo "Summary: $HEALTHY healthy, $UNHEALTHY unhealthy, $NOT_DEPLOYED not deployed"

if [ "$UNHEALTHY" -gt 0 ]; then
    exit 1
fi
