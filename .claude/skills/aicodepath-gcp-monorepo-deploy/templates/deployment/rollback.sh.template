#!/bin/bash
# Rollback helper script
# Auto-generated by gcp-monorepo-deploy skill
#
# Usage: ./scripts/rollback.sh <environment> <service> [revision]
# If revision not specified, lists available revisions to choose from.

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

if [ $# -lt 2 ]; then
    echo "Usage: ./scripts/rollback.sh <environment> <service> [revision]"
    echo ""
    echo "If revision not specified, will show list to choose from"
    echo ""
    echo "Examples:"
    echo "  ./scripts/rollback.sh staging api-gateway"
    echo "  ./scripts/rollback.sh prod auth-service api-gateway-prod-00003-abc"
    echo ""
    exit 1
fi

ENV=$1
SERVICE=$2
REVISION=${3:-}

# Load configuration
if [ ! -f ".gcp-projects" ]; then
    echo -e "${RED}Error: .gcp-projects not found${NC}"
    exit 1
fi

source .gcp-projects

# Determine project
case "$ENV" in
    dev) PROJECT=$DEV_PROJECT ;;
    staging) PROJECT=$STG_PROJECT ;;
    prod) PROJECT=$PROD_PROJECT ;;
    *)
        echo -e "${RED}Invalid environment: $ENV${NC}"
        exit 1
        ;;
esac

SERVICE_NAME="$SERVICE-$ENV"

echo -e "${YELLOW}Rolling back $SERVICE in $ENV${NC}"
echo "Project: $PROJECT"
echo "Region: $REGION"

if [ -z "$REVISION" ]; then
    # List available revisions
    echo ""
    echo "Available revisions:"
    gcloud run revisions list \
        --service="$SERVICE_NAME" \
        --project="$PROJECT" \
        --region="$REGION" \
        --format="table(name,status.conditions[0].status,spec.containerConcurrency,metadata.creationTimestamp)"

    echo ""
    read -p "Enter revision name to rollback to: " REVISION

    if [ -z "$REVISION" ]; then
        echo "Rollback cancelled"
        exit 1
    fi
fi

# Confirm
echo ""
echo -e "${YELLOW}About to rollback:${NC}"
echo "  Service: $SERVICE_NAME"
echo "  Environment: $ENV"
echo "  Target revision: $REVISION"
echo ""
read -p "Continue? (yes/no): " confirmation

if [ "$confirmation" != "yes" ]; then
    echo "Rollback cancelled"
    exit 1
fi

# Execute rollback
echo "Rolling back..."
gcloud run services update-traffic "$SERVICE_NAME" \
    --project="$PROJECT" \
    --region="$REGION" \
    --to-revisions="$REVISION=100"

echo ""
echo -e "${GREEN}Rollback complete!${NC}"

# Verify
SERVICE_URL=$(gcloud run services describe "$SERVICE_NAME" \
    --project="$PROJECT" \
    --region="$REGION" \
    --format='value(status.url)')

echo ""
echo "Service URL: $SERVICE_URL"
echo "Verify: curl $SERVICE_URL/health"
