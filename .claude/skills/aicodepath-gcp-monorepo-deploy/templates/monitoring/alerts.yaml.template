# Alerting policies for monorepo services
# Auto-generated by gcp-monorepo-deploy skill
#
# Apply with:
#   gcloud alpha monitoring policies create --policy-from-file=alerts-<env>.json --project=$PROJECT

alerts:
  - name: "High Error Rate - {{ENV}}"
    description: "Triggers when 5xx error rate exceeds threshold for 5 minutes"
    condition:
      filter: >
        resource.type="cloud_run_revision" AND
        metric.type="run.googleapis.com/request_count" AND
        metric.label.response_code_class="5xx"
      aggregation:
        alignment_period: "60s"
        per_series_aligner: ALIGN_RATE
      comparison: COMPARISON_GT
      threshold: 0.05  # 5% error rate
      duration: "300s"  # 5 minutes
    combiner: OR
    enabled: true
    notification_channels: []  # Add channel IDs after creation

  - name: "High Latency (P99) - {{ENV}}"
    description: "Triggers when P99 latency exceeds threshold for 5 minutes"
    condition:
      filter: >
        resource.type="cloud_run_revision" AND
        metric.type="run.googleapis.com/request_latencies"
      aggregation:
        alignment_period: "60s"
        per_series_aligner: ALIGN_DELTA
        cross_series_reducer: REDUCE_PERCENTILE_99
      comparison: COMPARISON_GT
      threshold: 2000  # 2 seconds P99
      duration: "300s"
    combiner: OR
    enabled: true
    notification_channels: []

