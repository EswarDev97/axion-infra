# Auto detect text files and normalize line endings
# Auto-generated by git-monorepo-config skill
* text=auto

# Force LF for shell scripts
*.sh text eol=lf
*.bash text eol=lf

# Denote binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
*.gz binary
*.tar binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary

# Language-specific (force LF)
*.js text eol=lf
*.ts text eol=lf
*.jsx text eol=lf
*.tsx text eol=lf
*.py text eol=lf
*.go text eol=lf
*.java text eol=lf
*.kt text eol=lf
*.rs text eol=lf
*.rb text eol=lf
*.php text eol=lf
*.cs text eol=lf
*.swift text eol=lf

# Config files
*.json text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.xml text eol=lf
*.ini text eol=lf
*.cfg text eol=lf
*.conf text eol=lf

# Documentation
*.md text eol=lf
*.txt text eol=lf
