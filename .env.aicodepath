# AICodePath Environment Configuration
# Generated by AICodePath init - 2026-05-19T14:06:32.173Z
# Source this file in your shell: source .env.aicodepath
# Or add to your project's .env file

# =============================================================================
# Development Mode
# =============================================================================
# When set to 'true', AICodePath will skip strict plugin/MCP checks
# Useful for development or when working offline
# Default: auto-detected (enabled if project path contains 'aicodepath-tool')
AICODEPATH_DEV_MODE=

# Legacy development mode flag (deprecated, use AICODEPATH_DEV_MODE instead)
# AICODEPATH_HOOK_DEV=

# =============================================================================
# GICL (Git-Integrated Context Learning)
# =============================================================================
# Disable GICL to opt-out of automatic context preservation in git workflow
# Default: false (GICL enabled by default)
# AICODEPATH_GICL_DISABLED=true

# =============================================================================
# Project Root Override (for monorepos)
# =============================================================================
# Set this to the monorepo root where .aicodepath/ lives.
# When working inside a monorepo service (e.g., services/auth/), AICodePath
# auto-detects the monorepo root via .aicodepath/ directory. Use this override
# only if auto-detection doesn't work for your structure.
# AICODEPATH_PROJECT_ROOT=/path/to/monorepo

# =============================================================================
# Database Configuration
# =============================================================================
# Override default database path (aicodepath-docs/aicodepath.db)
# AICODEPATH_DB_PATH=/custom/path/to/aicodepath.db

# =============================================================================
# Logging & Debugging
# =============================================================================
# Enable verbose debug logging
# DEBUG=true

# Set log level (error, warn, info, debug)
# LOG_LEVEL=info

# =============================================================================
# API Configuration (for dashboard/AI assistant features)
# =============================================================================
# API server port (backend API and WebSocket server)
# Dashboard (Vite) runs on port 3899 and proxies to this port
PORT=3888
API_PORT=3888

# Anthropic API key (required for AI Assistant features)
# Get your API key from: https://console.anthropic.com/
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: Custom model selection
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
