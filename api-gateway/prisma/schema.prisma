// =============================================================================
// MindFlow HRMS Database Schema
// Multi-tenant ready with tenant_id on all relevant tables
// =============================================================================
//
// IMPORTANT: Prisma is READ-ONLY and NOT schema-authoritative.
// - ALL schema changes MUST go through Alembic migrations
// - DO NOT run `prisma migrate` or `prisma db push`
// - Use `prisma generate` only to regenerate the client
// - Use `prisma db pull` to sync schema from database (with caution)
//
// Migration Authority: backend/alembic/
// Schema Source of Truth: PostgreSQL database
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// TENANT & ORGANIZATION
// ============================================================================

model Tenant {
  id            String    @id @default(uuid())
  name          String
  slug          String    @unique
  domain        String?   @unique
  logo          String?
  settings      Json      @default("{}")
  plan          PlanType  @default(FREE)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  users         User[]
  departments   Department[]
  employees     Employee[]
  roles         Role[]
  attendances   Attendance[]
  leaves        Leave[]
  leaveTypes    LeaveType[]
  payrolls      Payroll[]
  documents     Document[]
  jobPostings   JobPosting[]
  applications  JobApplication[]
  announcements Announcement[]
  holidays      Holiday[]

  @@map("tenants")
}

enum PlanType {
  FREE
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

// ============================================================================
// USERS & AUTHENTICATION
// ============================================================================

model User {
  id              String    @id @default(uuid())
  tenantId        String?
  email           String
  passwordHash    String
  firstName       String
  lastName        String
  phone           String?
  avatar          String?
  isActive        Boolean   @default(true)
  isEmailVerified Boolean   @default(false)
  lastLoginAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  tenant          Tenant?   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee        Employee?
  userRoles       UserRole[]
  refreshTokens   RefreshToken[]
  otpCodes        OtpCode[]
  auditLogs       AuditLog[]
  notifications   Notification[]

  @@unique([tenantId, email])
  @@index([email])
  @@map("users")
}

model RefreshToken {
  id          String    @id @default(uuid())
  userId      String
  token       String    @unique
  expiresAt   DateTime
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model OtpCode {
  id          String    @id @default(uuid())
  userId      String
  code        String
  type        OtpType
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("otp_codes")
}

enum OtpType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  TWO_FACTOR
}

// ============================================================================
// ROLES & PERMISSIONS (RBAC)
// ============================================================================

model Role {
  id          String    @id @default(uuid())
  tenantId    String?
  name        String
  slug        String
  description String?
  isSystem    Boolean   @default(false)  // System roles can't be deleted
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  tenant          Tenant?         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@unique([tenantId, slug])
  @@map("roles")
}

model Permission {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  module      String    // e.g., 'employees', 'payroll', 'leave'
  action      String    // e.g., 'create', 'read', 'update', 'delete'
  description String?
  createdAt   DateTime  @default(now())

  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String    @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime  @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id        String    @id @default(uuid())
  userId    String
  roleId    String
  tenantId  String
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, tenantId])
  @@map("user_tenant_roles")
}

// ============================================================================
// DEPARTMENTS
// ============================================================================

model Department {
  id          String    @id @default(uuid())
  tenantId    String
  name        String
  code        String
  description String?
  managerId   String?   // References Employee
  parentId    String?   // Self-reference for hierarchy
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  manager     Employee?   @relation("DepartmentManager", fields: [managerId], references: [id])
  parent      Department? @relation("DepartmentHierarchy", fields: [parentId], references: [id])
  children    Department[] @relation("DepartmentHierarchy")
  employees   Employee[]
  jobPostings JobPosting[]

  @@unique([tenantId, code])
  @@map("departments")
}

// ============================================================================
// EMPLOYEES
// ============================================================================

model Employee {
  id                String    @id @default(uuid())
  tenantId          String
  userId            String    @unique
  employeeCode      String
  departmentId      String?
  managerId         String?   // Self-reference for reporting hierarchy
  designation       String
  employmentType    EmploymentType @default(FULL_TIME)
  employmentStatus  EmploymentStatus @default(ACTIVE)
  dateOfJoining     DateTime
  dateOfLeaving     DateTime?
  probationEndDate  DateTime?

  // Personal Info
  dateOfBirth       DateTime?
  gender            Gender?
  maritalStatus     MaritalStatus?
  bloodGroup        String?
  nationality       String?

  // Contact Info
  personalEmail     String?
  workEmail         String?
  personalPhone     String?
  workPhone         String?
  currentAddress    Json?
  permanentAddress  Json?
  emergencyContact  Json?

  // Bank & Tax Info
  bankDetails       Json?
  taxInfo           Json?

  // Compensation
  salary            Decimal?  @db.Decimal(12, 2)

  // Other
  notes             String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  // Relations
  tenant              Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user                User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  department          Department?   @relation(fields: [departmentId], references: [id])
  manager             Employee?     @relation("EmployeeHierarchy", fields: [managerId], references: [id])
  subordinates        Employee[]    @relation("EmployeeHierarchy")
  managedDepartments  Department[]  @relation("DepartmentManager")
  attendances         Attendance[]
  leaves              Leave[]
  leaveBalances       LeaveBalance[]
  payrolls            Payroll[]
  documents           Document[]
  salaryStructure     SalaryStructure?

  @@unique([tenantId, employeeCode])
  @@index([tenantId, departmentId])
  @@map("employees")
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERN
  CONSULTANT
}

enum EmploymentStatus {
  ACTIVE
  ON_NOTICE
  TERMINATED
  RESIGNED
  RETIRED
  ON_LEAVE
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
}

// ============================================================================
// ATTENDANCE
// ============================================================================

model Attendance {
  id            String    @id @default(uuid())
  tenantId      String
  employeeId    String
  date          DateTime  @db.Date
  checkIn       DateTime?
  checkOut      DateTime?
  workHours     Decimal?  @db.Decimal(4, 2)
  overtimeHours Decimal?  @db.Decimal(4, 2)
  status        AttendanceStatus @default(PRESENT)
  source        AttendanceSource @default(MANUAL)
  location      Json?     // For geo-tracking
  notes         String?
  approvedBy    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@index([tenantId, date])
  @@map("attendance_records")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  HALF_DAY
  ON_LEAVE
  HOLIDAY
  WEEKLY_OFF
  WEEKEND
  WORK_FROM_HOME
}

enum AttendanceSource {
  MANUAL
  BIOMETRIC
  MOBILE_APP
  WEB_PORTAL
}

// ============================================================================
// LEAVE MANAGEMENT
// ============================================================================

model LeaveType {
  id                  String    @id @default(uuid())
  tenantId            String
  name                String
  code                String
  description         String?
  defaultDays         Int       @default(0)
  carryForward        Boolean   @default(false)
  maxCarryForward     Int?
  isPaid              Boolean   @default(true)
  requiresApproval    Boolean   @default(true)
  requiresDocument    Boolean   @default(false)
  minDaysNotice       Int       @default(0)
  maxConsecutiveDays  Int?
  applicableGender    Gender?
  isActive            Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Relations
  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leaves        Leave[]
  leaveBalances LeaveBalance[]

  @@unique([tenantId, code])
  @@map("leave_types")
}

model LeaveBalance {
  id          String    @id @default(uuid())
  employeeId  String
  leaveTypeId String
  year        Int
  allocated   Decimal   @db.Decimal(5, 2)
  used        Decimal   @default(0) @db.Decimal(5, 2)
  pending     Decimal   @default(0) @db.Decimal(5, 2)
  carryForward Decimal  @default(0) @db.Decimal(5, 2)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, leaveTypeId, year])
  @@map("leave_balances")
}

model Leave {
  id            String    @id @default(uuid())
  tenantId      String
  employeeId    String
  leaveTypeId   String
  startDate     DateTime  @db.Date
  endDate       DateTime  @db.Date
  days          Decimal   @db.Decimal(5, 2)
  reason        String?
  status        LeaveStatus @default(PENDING)
  approvedBy    String?
  approvedAt    DateTime?
  rejectionNote String?
  documentUrl   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  tenant    Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee  Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  leaveType LeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([employeeId, startDate, endDate])
  @@map("leave_requests")
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
  WITHDRAWN
}

// ============================================================================
// PAYROLL
// ============================================================================

model SalaryStructure {
  id            String    @id @default(uuid())
  employeeId    String    @unique
  baseSalary    Decimal   @db.Decimal(12, 2)
  currency      String    @default("INR")
  payFrequency  PayFrequency @default(MONTHLY)
  effectiveFrom DateTime
  effectiveTo   DateTime?
  components    Json      // Array of salary components with amounts
  deductions    Json?     // Fixed deductions
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("salary_structures")
}

enum PayFrequency {
  WEEKLY
  BI_WEEKLY
  MONTHLY
}

model Payroll {
  id              String    @id @default(uuid())
  tenantId        String
  employeeId      String
  month           Int
  year            Int

  // Earnings
  basicSalary     Decimal   @db.Decimal(12, 2)
  allowances      Json?     // Detailed allowance breakdown
  overtime        Decimal   @default(0) @db.Decimal(12, 2)
  bonus           Decimal   @default(0) @db.Decimal(12, 2)
  grossSalary     Decimal   @db.Decimal(12, 2)

  // Deductions
  tax             Decimal   @default(0) @db.Decimal(12, 2)
  providentFund   Decimal   @default(0) @db.Decimal(12, 2)
  insurance       Decimal   @default(0) @db.Decimal(12, 2)
  otherDeductions Json?
  totalDeductions Decimal   @db.Decimal(12, 2)

  // Net
  netSalary       Decimal   @db.Decimal(12, 2)

  // Meta
  status          PayrollStatus @default(DRAFT)
  processedAt     DateTime?
  paidAt          DateTime?
  payslipUrl      String?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  tenant   Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, month, year])
  @@index([tenantId, month, year])
  @@map("payrolls")
}

enum PayrollStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PROCESSING
  PAID
  CANCELLED
}

// ============================================================================
// DOCUMENTS
// ============================================================================

model Document {
  id           String    @id @default(uuid())
  tenantId     String
  employeeId   String?
  name         String
  type         DocumentType
  category     String?
  fileUrl      String
  fileSize     Int?
  mimeType     String?
  description  String?
  metadata     Json?     // AI-extracted metadata
  uploadedBy   String?
  isVerified   Boolean   @default(false)
  expiresAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relations
  tenant   Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  employee Employee? @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([tenantId, type])
  @@index([employeeId])
  @@map("documents")
}

enum DocumentType {
  RESUME
  OFFER_LETTER
  APPOINTMENT_LETTER
  PAYSLIP
  TAX_DOCUMENT
  ID_PROOF
  ADDRESS_PROOF
  EDUCATION_CERTIFICATE
  EXPERIENCE_CERTIFICATE
  CONTRACT
  POLICY
  OTHER
}

// ============================================================================
// COMPANY WEBSITE - CAREERS
// ============================================================================

model JobPosting {
  id              String    @id @default(uuid())
  tenantId        String
  departmentId    String?
  title           String
  slug            String
  description     String    @db.Text
  requirements    String?   @db.Text
  responsibilities String?  @db.Text
  location        String?
  employmentType  EmploymentType @default(FULL_TIME)
  experienceMin   Int?
  experienceMax   Int?
  salaryMin       Decimal?  @db.Decimal(12, 2)
  salaryMax       Decimal?  @db.Decimal(12, 2)
  showSalary      Boolean   @default(false)
  skills          String[]
  benefits        String[]
  status          JobStatus @default(DRAFT)
  publishedAt     DateTime?
  expiresAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  department   Department?     @relation(fields: [departmentId], references: [id])
  applications JobApplication[]

  @@unique([tenantId, slug])
  @@index([tenantId, status])
  @@map("job_postings")
}

enum JobStatus {
  DRAFT
  PUBLISHED
  PAUSED
  CLOSED
  FILLED
}

model JobApplication {
  id            String    @id @default(uuid())
  tenantId      String
  jobPostingId  String

  // Applicant Info
  firstName     String
  lastName      String
  email         String
  phone         String?
  resumeUrl     String?
  coverLetter   String?   @db.Text
  linkedIn      String?
  portfolio     String?

  // Parsed Data (from AI)
  parsedData    Json?

  // Application Status
  status        ApplicationStatus @default(NEW)
  stage         String    @default("Applied")
  rating        Int?      // 1-5
  notes         String?   @db.Text

  // Tracking
  source        String?   // Where they found the job
  referredBy    String?
  reviewedBy    String?
  reviewedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  jobPosting JobPosting @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)

  @@index([tenantId, status])
  @@index([jobPostingId])
  @@map("job_applications")
}

enum ApplicationStatus {
  NEW
  SCREENING
  INTERVIEW_SCHEDULED
  INTERVIEWED
  SHORTLISTED
  OFFER_SENT
  OFFER_ACCEPTED
  OFFER_DECLINED
  REJECTED
  WITHDRAWN
  HIRED
}

// ============================================================================
// COMPANY WEBSITE - CONTENT
// ============================================================================

model Announcement {
  id          String    @id @default(uuid())
  tenantId    String
  title       String
  content     String    @db.Text
  type        AnnouncementType @default(GENERAL)
  priority    Int       @default(0)
  isPublic    Boolean   @default(false)  // Show on website
  isActive    Boolean   @default(true)
  publishedAt DateTime?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, isPublic, isActive])
  @@map("announcements")
}

enum AnnouncementType {
  GENERAL
  HOLIDAY
  EVENT
  POLICY
  URGENT
}

model Holiday {
  id          String    @id @default(uuid())
  tenantId    String
  name        String
  date        DateTime  @db.Date
  type        HolidayType @default(PUBLIC)
  isOptional  Boolean   @default(false)
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, date, name])
  @@index([tenantId, date])
  @@map("holidays")
}

enum HolidayType {
  PUBLIC
  COMPANY
  RESTRICTED
}

// ============================================================================
// CONTACT & INQUIRIES
// ============================================================================

model ContactInquiry {
  id          String    @id @default(uuid())
  name        String
  email       String
  phone       String?
  company     String?
  subject     String
  message     String    @db.Text
  type        InquiryType @default(GENERAL)
  status      InquiryStatus @default(NEW)
  assignedTo  String?
  respondedAt DateTime?
  response    String?   @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, type])
  @@map("contact_inquiries")
}

enum InquiryType {
  GENERAL
  SALES
  SUPPORT
  PARTNERSHIP
  CAREERS
}

enum InquiryStatus {
  NEW
  IN_PROGRESS
  RESPONDED
  CLOSED
  SPAM
}

// ============================================================================
// TASKS
// ============================================================================

model TaskStatus {
  id                  String    @id @default(uuid())
  tenantId            String
  code                String
  name                String
  description         String?
  color               String    @default("#6B7280")
  sortOrder           Int       @default(0) @map("sort_order")
  isDefault           Boolean   @default(false) @map("is_default")
  isTerminal          Boolean   @default(false) @map("is_terminal")
  allowedTransitions  Json      @default("[]") @map("allowed_transitions")
  isActive            Boolean   @default(true) @map("is_active")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  createdBy           String?   @map("created_by")
  updatedBy           String?   @map("updated_by")

  // Relations
  tasks Task[]

  @@unique([tenantId, code])
  @@map("task_statuses")
}

model Task {
  id                      String    @id @default(uuid())
  tenantId                String    @map("tenant_id")
  title                   String
  description             String?
  statusId                String    @map("status_id")
  priority                TaskPriority @default(MEDIUM)
  parentTaskId            String?   @map("parent_task_id")
  originType              String    @default("MANUAL") @map("origin_type")
  originReferenceId       String?   @map("origin_reference_id")
  expectedCompletionDate  DateTime? @db.Date @map("expected_completion_date")
  actualCompletionDate    DateTime? @db.Date @map("actual_completion_date")
  estimatedHours          Decimal?  @db.Decimal(6, 2) @map("estimated_hours")
  actualHours             Decimal?  @db.Decimal(6, 2) @map("actual_hours")
  tags                    Json      @default("[]")
  isDeleted               Boolean   @default(false) @map("is_deleted")
  deletedAt               DateTime? @map("deleted_at")
  deletionReason          String?   @map("deletion_reason")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")
  createdBy               String?   @map("created_by")
  updatedBy               String?   @map("updated_by")

  // Relations
  status      TaskStatus    @relation(fields: [statusId], references: [id])
  parentTask  Task?         @relation("TaskHierarchy", fields: [parentTaskId], references: [id])
  subtasks    Task[]        @relation("TaskHierarchy")
  assignees   TaskAssignee[]
  comments    TaskComment[]
  attachments TaskAttachment[]
  dependenciesAsTask      TaskDependency[] @relation("TaskDependencies")
  dependenciesAsDependsOn TaskDependency[] @relation("DependsOnTask")

  @@index([tenantId, statusId])
  @@index([tenantId, isDeleted])
  @@map("tasks")
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model TaskAssignee {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  taskId      String    @map("task_id")
  userId      String    @map("user_id")
  assignedBy  String    @map("assigned_by")
  assignedAt  DateTime  @default(now()) @map("assigned_at")
  role        String    @default("ASSIGNEE")
  createdAt   DateTime  @default(now()) @map("created_at")

  // Relations
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([tenantId])
  @@map("task_assignees")
}

model TaskComment {
  id            String    @id @default(uuid())
  tenantId      String    @map("tenant_id")
  taskId        String    @map("task_id")
  content       String
  isInternal    Boolean   @default(false) @map("is_internal")
  parentId      String?   @map("parent_id")
  isDeleted     Boolean   @default(false) @map("is_deleted")
  deletedAt     DateTime? @map("deleted_at")
  deletionReason String?  @map("deletion_reason")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  createdBy     String    @map("created_by")
  updatedBy     String    @map("updated_by")

  // Relations
  task        Task          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  parentComment TaskComment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies     TaskComment[] @relation("CommentReplies")

  @@index([tenantId, taskId])
  @@map("task_comments")
}

model TaskAttachment {
  id          String    @id @default(uuid())
  tenantId    String    @map("tenant_id")
  taskId      String    @map("task_id")
  fileId      String    @map("file_id")
  attachedBy  String    @map("attached_by")
  attachedAt  DateTime  @default(now()) @map("attached_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  // Relations
  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@map("task_attachments")
}

model TaskDependency {
