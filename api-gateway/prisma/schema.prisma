}

model ExamResponse {
  id            String    @id @default(uuid())
  tenantId      String    @map("tenant_id")
  attemptId     String    @map("attempt_id")
  questionId    String    @map("question_id")
  answer        Json
  isCorrect     Boolean?  @map("is_correct")
  pointsEarned  Int?      @map("points_earned")
  answeredAt    DateTime  @default(now()) @map("answered_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  // Relations
  attempt  ExamAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question ExamQuestion @relation(fields: [questionId], references: [id])

  @@unique([attemptId, questionId])
  @@map("exam_responses")
}

model Certificate {
  id                  String    @id @default(uuid())
  tenantId            String    @map("tenant_id")
  certificateNumber   String    @map("certificate_number")
  employeeId          String    @map("employee_id")
  courseId            String    @map("course_id")
  courseTitle         String    @map("course_title")
  issueDate           DateTime  @db.Date @map("issue_date")
  expiryDate          DateTime? @db.Date @map("expiry_date")
  score               Int?
  grade               String?
  fileId              String?   @map("file_id")
  verificationCode    String    @map("verification_code")
  status              String    @default("ACTIVE")
  revokedAt           DateTime? @map("revoked_at")
  revocationReason    String?   @map("revocation_reason")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  issuedBy            String    @map("issued_by")

  // Relations
  enrollments Enrollment[]

  @@unique([tenantId, certificateNumber])
  @@unique([tenantId, verificationCode])
  @@map("certificates")
}

// ============================================================================
// MINDMAP SERVICE (4 tables)
// ============================================================================

model MindMapTemplate {
  id              String    @id @default(uuid())
  tenantId        String    @map("tenant_id")
  name            String
  description     String?
  category        String?
  templateData    Json      @default("{}") @map("template_data")
  thumbnailFileId String?   @map("thumbnail_file_id")
  isPublic        Boolean   @default(false) @map("is_public")
  usageCount      Int       @default(0) @map("usage_count")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  createdBy       String    @map("created_by")
  updatedBy       String    @map("updated_by")
  isDeleted       Boolean   @default(false) @map("is_deleted")
  deletedAt       DateTime? @map("deleted_at")

  // Relations
  mindMaps MindMap[]

  @@map("mind_map_templates")
}

model MindMap {
  id                  String    @id @default(uuid())
  tenantId            String    @map("tenant_id")
  title               String
  description         String?
  ownerId             String    @map("owner_id")
  templateId          String?   @map("template_id")
  originType          String    @default("MANUAL") @map("origin_type")
  originReferenceId   String?   @map("origin_reference_id")
  visibility          String    @default("PRIVATE")
  collaboratorIds     Json      @default("[]") @map("collaborator_ids")
  settings            Json      @default("{}") @map("settings")
  thumbnailFileId     String?   @map("thumbnail_file_id")
  lastAccessedAt      DateTime  @default(now()) @map("last_accessed_at")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  createdBy           String    @map("created_by")
  updatedBy           String    @map("updated_by")
  isDeleted           Boolean   @default(false) @map("is_deleted")
  deletedAt           DateTime? @map("deleted_at")
  deletionReason      String?   @map("deletion_reason")

  // Relations
  template MindMapTemplate? @relation(fields: [templateId], references: [id])
  nodes    MindMapNode[]

  @@map("mind_maps")
}

model MindMapNode {
  id              String    @id @default(uuid())
  tenantId        String    @map("tenant_id")
  mindMapId       String    @map("mind_map_id")
  parentId        String?   @map("parent_id")
  nodeType        String    @default("TOPIC") @map("node_type")
  title           String
  content         String?
  positionX       Decimal   @default(0) @db.Decimal(10, 2) @map("position_x")
  positionY       Decimal   @default(0) @db.Decimal(10, 2) @map("position_y")
  width           Decimal?  @db.Decimal(10, 2)
  height          Decimal?  @db.Decimal(10, 2)
  style           Json      @default("{}")
  metadata        Json      @default("{}")
  sortOrder       Int       @default(0) @map("sort_order")
  isCollapsed     Boolean   @default(false) @map("is_collapsed")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  createdBy       String    @map("created_by")
  updatedBy       String    @map("updated_by")

  // Relations
  mindMap     MindMap          @relation(fields: [mindMapId], references: [id], onDelete: Cascade)
  parent      MindMapNode?     @relation("NodeHierarchy", fields: [parentId], references: [id])
  children    MindMapNode[]    @relation("NodeHierarchy")
  attachments NodeAttachment[]

  @@map("mind_map_nodes")
}

model NodeAttachment {
  id              String    @id @default(uuid())
  tenantId        String    @map("tenant_id")
  nodeId          String    @map("node_id")
  attachmentType  String    @map("attachment_type")
  fileId          String?   @map("file_id")
  url             String?
  title           String?
  description     String?
  metadata        Json      @default("{}")
  sortOrder       Int       @default(0) @map("sort_order")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  createdBy       String    @map("created_by")

  // Relations
  node MindMapNode @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@map("node_attachments")
}

// ============================================================================
// REPORT SERVICE (3 tables)
// ============================================================================

model Report {
  id              String    @id @default(uuid())
  tenantId        String    @map("tenant_id")
  code            String
  name            String
  description     String?
  category        String
  reportType      String    @default("STANDARD") @map("report_type")
  dataSource      String    @map("data_source")
  queryTemplate   String    @map("query_template")
  outputFormats   Json      @default("[\"PDF\", \"EXCEL\"]") @map("output_formats")
  isSystem        Boolean   @default(false) @map("is_system")
  isActive        Boolean   @default(true) @map("is_active")
  allowedRoles    Json      @default("[]") @map("allowed_roles")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  createdBy       String    @map("created_by")
  updatedBy       String    @map("updated_by")

  // Relations
  parameters  ReportParameter[]
  executions  ReportExecution[]

  @@unique([tenantId, code])
  @@map("reports")
}

model ReportParameter {
  id              String    @id @default(uuid())
  tenantId        String    @map("tenant_id")
  reportId        String    @map("report_id")
  name            String
  label           String
  parameterType   String    @map("parameter_type")
  isRequired      Boolean   @default(false) @map("is_required")
  defaultValue    String?   @map("default_value")
  validationRule  String?   @map("validation_rule")
  options         Json?
  sortOrder       Int       @default(0) @map("sort_order")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  // Relations
  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@unique([reportId, name])
  @@map("report_parameters")
}

model ReportExecution {
  id              String    @id @default(uuid())
  tenantId        String    @map("tenant_id")
  reportId        String    @map("report_id")
  executedBy      String    @map("executed_by")
  parameters      Json      @default("{}")
  status          String    @default("PENDING")
  startedAt       DateTime? @map("started_at")
  completedAt     DateTime? @map("completed_at")
  outputFormat    String    @map("output_format")
  outputFileId    String?   @map("output_file_id")
  errorMessage    String?   @map("error_message")
  rowCount        Int?      @map("row_count")
  executionTime   Int?      @map("execution_time")
  createdAt       DateTime  @default(now()) @map("created_at")

  // Relations
  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@map("report_executions")
}

// ============================================================================
// STORAGE SERVICE (1 table)
// ============================================================================

model FileMetadata {
  id              String    @id @default(uuid())
  tenantId        String    @map("tenant_id")
  originalFilename String   @map("original_filename")
  storedFilename  String    @map("stored_filename")
  contentType     String    @map("content_type")
  fileSize        BigInt    @map("file_size")
  bucketName      String    @map("bucket_name")
  objectKey       String    @map("object_key")
  module          String
  entityType      String?   @map("entity_type")
  entityId        String?   @map("entity_id")
  description     String?
  checksum        String?
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  createdBy       String    @map("created_by")
  updatedBy       String    @map("updated_by")
  isDeleted       Boolean   @default(false) @map("is_deleted")
  deletedAt       DateTime? @map("deleted_at")
  deletionReason  String?   @map("deletion_reason")

  @@map("file_metadata")
}

// ============================================================================
// NOTIFICATION PREFERENCES (additional table for notification service)
// ============================================================================

model NotificationPreference {
  id                String    @id @default(uuid())
  tenantId          String    @map("tenant_id")
  userId            String    @map("user_id")
  notificationType  String    @map("notification_type")
  inAppEnabled      Boolean   @default(true) @map("in_app_enabled")
  emailEnabled      Boolean   @default(false) @map("email_enabled")
  pushEnabled       Boolean   @default(false) @map("push_enabled")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  @@unique([tenantId, userId, notificationType])
  @@map("notification_preferences")
}

// ============================================================================
// BILLING SERVICE (Quotes, Invoices, Exchange Rates)
// Multi-currency support: INR, USD
// ============================================================================

model Quote {
  id              String    @id @default(uuid())
  tenantId        String    @map("tenant_id")
  clientId        String    @map("client_id")
  quoteNumber     String    @map("quote_number")
  title           String
  description     String?
  currency        String    @default("INR") @db.VarChar(3)
  subtotal        Decimal   @default(0) @db.Decimal(15, 2)
  taxPercentage   Decimal   @default(0) @map("tax_percentage") @db.Decimal(5, 2)
  taxAmount       Decimal   @default(0) @map("tax_amount") @db.Decimal(15, 2)
  totalAmount     Decimal   @default(0) @map("total_amount") @db.Decimal(15, 2)
  status          String    @default("DRAFT") @db.VarChar(30)
  validUntil      DateTime? @map("valid_until") @db.Date
  notes           String?
  terms           String?
  issuedAt        DateTime? @map("issued_at")
  acceptedAt      DateTime? @map("accepted_at")
  rejectedAt      DateTime? @map("rejected_at")
  rejectionReason String?   @map("rejection_reason")
  isDeleted       Boolean   @default(false) @map("is_deleted")
  deletedAt       DateTime? @map("deleted_at")
  deletionReason  String?   @map("deletion_reason")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  createdBy       String    @map("created_by")
  updatedBy       String    @map("updated_by")

  // Relations
  items           QuoteItem[]
  invoices        Invoice[]

  @@unique([tenantId, quoteNumber])
  @@index([tenantId])
  @@index([clientId])
  @@index([status])
  @@map("quotes")
}

model QuoteItem {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  quoteId     String   @map("quote_id")
  description String   @db.VarChar(255)
  quantity    Decimal  @default(1) @db.Decimal(10, 2)
  rate        Decimal  @db.Decimal(15, 2)
  amount      Decimal  @db.Decimal(15, 2)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdBy   String   @map("created_by")
  updatedBy   String   @map("updated_by")

  // Relations
  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([quoteId])
  @@map("quote_items")
}

model Invoice {
  id                 String    @id @default(uuid())
  tenantId           String    @map("tenant_id")
  clientId           String    @map("client_id")
  quoteId            String?   @map("quote_id")
  invoiceNumber      String    @map("invoice_number")
  title              String
  description        String?
  currency           String    @default("INR") @db.VarChar(3)
  subtotal           Decimal   @default(0) @db.Decimal(15, 2)
  taxPercentage      Decimal   @default(0) @map("tax_percentage") @db.Decimal(5, 2)
  taxAmount          Decimal   @default(0) @map("tax_amount") @db.Decimal(15, 2)
  totalAmount        Decimal   @default(0) @map("total_amount") @db.Decimal(15, 2)
  status             String    @default("DRAFT") @db.VarChar(30)
  dueDate            DateTime? @map("due_date") @db.Date
  notes              String?
  terms              String?
  issuedAt           DateTime? @map("issued_at")
  paidAt             DateTime? @map("paid_at")
  cancelledAt        DateTime? @map("cancelled_at")
  cancellationReason String?   @map("cancellation_reason")
  isDeleted          Boolean   @default(false) @map("is_deleted")
  deletedAt          DateTime? @map("deleted_at")
  deletionReason     String?   @map("deletion_reason")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  createdBy          String    @map("created_by")
  updatedBy          String    @map("updated_by")

  // Relations
  quote  Quote?        @relation(fields: [quoteId], references: [id])
  items  InvoiceItem[]

  @@unique([tenantId, invoiceNumber])
  @@index([tenantId])
  @@index([clientId])
  @@index([quoteId])
  @@index([status])
  @@map("invoices")
}

model InvoiceItem {
  id          String   @id @default(uuid())
  tenantId    String   @map("tenant_id")
  invoiceId   String   @map("invoice_id")
  description String   @db.VarChar(255)
  quantity    Decimal  @default(1) @db.Decimal(10, 2)
  rate        Decimal  @db.Decimal(15, 2)
  amount      Decimal  @db.Decimal(15, 2)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  createdBy   String   @map("created_by")
  updatedBy   String   @map("updated_by")

  // Relations
  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([invoiceId])
  @@map("invoice_items")
}

model ExchangeRate {
  id             String   @id @default(uuid())
  tenantId       String   @map("tenant_id")
  fromCurrency   String   @map("from_currency") @db.VarChar(3)
  toCurrency     String   @map("to_currency") @db.VarChar(3)
  rate           Decimal  @db.Decimal(12, 6)
  effectiveDate  DateTime @map("effective_date") @db.Date
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  createdBy      String   @map("created_by")
  updatedBy      String   @map("updated_by")

  @@index([tenantId])
  @@index([fromCurrency, toCurrency])
  @@map("exchange_rates")
}
