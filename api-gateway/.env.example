# AxionPCS API Gateway Environment Variables

# Server Configuration
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# Database (PostgreSQL)
DATABASE_URL=postgresql://axionpcs:axionpcs_secret@postgres:5432/axionpcs_db?schema=public

# Redis Configuration
REDIS_URL=redis://redis:6379
REDIS_PREFIX=axionpcs:

# Session Configuration
SESSION_SECRET=your-super-secret-session-key-change-in-production
SESSION_TTL=86400

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
JWT_ISSUER=axionpcs

# MinIO (S3-compatible Object Storage)
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=axionpcs_minio
MINIO_SECRET_KEY=axionpcs_minio_secret
MINIO_BUCKET_DOCUMENTS=axionpcs-documents
MINIO_BUCKET_AVATARS=axionpcs-avatars

# AI Services
AI_SERVICE_RESUME_PARSER_URL=http://ai-resume-parser:8001
AI_SERVICE_DOCUMENT_CLASSIFIER_URL=http://ai-document-classifier:8002
AI_SERVICE_HR_ANALYTICS_URL=http://ai-hr-analytics:8003

# Email Configuration (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=AxionPCS
SMTP_FROM_EMAIL=noreply@axionpcs.com

# OTP Configuration
OTP_EXPIRY_MINUTES=10
OTP_LENGTH=6

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
CORS_ORIGIN=http://localhost:3002
CORS_CREDENTIALS=true

# Logging
LOG_LEVEL=debug
LOG_FORMAT=dev

# Multi-tenant
DEFAULT_TENANT_SLUG=axionpcs
SUPER_ADMIN_EMAIL=admin@axionpcs.com

# File Upload Limits
MAX_FILE_SIZE_MB=10
ALLOWED_FILE_TYPES=pdf,doc,docx,jpg,jpeg,png,gif

# Pagination Defaults
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100
