# MindFlow Backend Environment Variables
# Copy to .env and customize for your environment

# Application
ENVIRONMENT=development
DEBUG=true

# Database - PostgreSQL 16 (per TECH_STACK.md)
DATABASE_URL=postgresql+asyncpg://mindflow:mindflow@localhost:5432/mindflow
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Redis 7 (per TECH_STACK.md)
REDIS_URL=redis://localhost:6379/0
REDIS_SESSION_DB=0
REDIS_CELERY_BROKER_DB=1
REDIS_CELERY_BACKEND_DB=2
REDIS_CACHE_DB=3

# MinIO (per TECH_STACK.md)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
MINIO_BUCKET_NAME=mindflow

# JWT Authentication (per API_CONTRACT.md)
# IMPORTANT: Change in production!
JWT_SECRET_KEY=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
JWT_ISSUER=mindflow

# Security (per THREAT_MODEL.md)
PASSWORD_MIN_LENGTH=12
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=30

# CORS
CORS_ORIGINS=http://localhost:3002,http://127.0.0.1:3002

# Logging
LOG_LEVEL=INFO
