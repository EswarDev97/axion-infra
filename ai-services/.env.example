# AxionPCS AI Services Environment Variables

# Common Settings
ENVIRONMENT=development
LOG_LEVEL=DEBUG

# API Gateway Connection
API_GATEWAY_URL=http://api-gateway:3001

# Redis (for caching AI results)
REDIS_URL=redis://redis:6379
REDIS_PREFIX=axionpcs:ai:

# MinIO (for accessing documents)
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=axionpcs_minio
MINIO_SECRET_KEY=axionpcs_minio_secret
MINIO_BUCKET_DOCUMENTS=axionpcs-documents

# Resume Parser Service
RESUME_PARSER_HOST=0.0.0.0
RESUME_PARSER_PORT=8001
RESUME_PARSER_WORKERS=2

# Document Classifier Service
DOCUMENT_CLASSIFIER_HOST=0.0.0.0
DOCUMENT_CLASSIFIER_PORT=8002
DOCUMENT_CLASSIFIER_WORKERS=2

# HR Analytics Service
HR_ANALYTICS_HOST=0.0.0.0
HR_ANALYTICS_PORT=8003
HR_ANALYTICS_WORKERS=2

# Database (for analytics queries - read-only)
DATABASE_URL=postgresql://axionpcs:axionpcs_secret@postgres:5432/axionpcs_db

# AI Model Configuration
# For resume parsing
SPACY_MODEL=en_core_web_sm
USE_GPU=false

# For document classification
CLASSIFIER_MODEL_PATH=/models/document_classifier.pkl
CLASSIFIER_CONFIDENCE_THRESHOLD=0.7

# External AI APIs (optional - for enhanced features)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-3.5-turbo

# Hugging Face (optional)
HF_API_TOKEN=
HF_MODEL_ENDPOINT=

# Request Limits
MAX_DOCUMENT_SIZE_MB=10
MAX_CONCURRENT_REQUESTS=10
REQUEST_TIMEOUT_SECONDS=30
